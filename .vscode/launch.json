{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET MAUI mac",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "maccatalyst: run",
            // "program": ""
            "program": "${workspaceFolder}/.vscode/noop.js"
        },

        {
            "name": "Mac Catalyst: Attach (already running)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },

        {
            "name": "Mac Catalyst: Attach by PID",
            "type": "coreclr",
            "request": "attach",
            "processId": "${input:ChronoWizPid}"
        }
    ],
    "inputs": [
        {
            "id": "ChronoWizPid",
            "type": "promptString",
            "description": "Enter ChronoWiz PID (get it via: pgrep -fl ChronoWiz)",
            "default": ""
        }
    ]
}