<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChronoWiz.Avalonia.Linux.ViewModels"
             x:Class="ChronoWiz.Avalonia.Linux.Views.SaveToIcsView"
             x:DataType="vm:SaveToIcsViewModel">
	<ScrollViewer Background="#FF000000">
		<StackPanel Margin="20" Spacing="12" Background="#FF000000">
			<Button Content="Back" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" />
			<TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="White" />
			<TextBlock Text="Summary" Foreground="White" />
			<TextBox Text="{Binding Summary}" />
			<TextBlock Text="Description" Foreground="White" />
			<TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="80" />
			<TextBlock Text="Location" Foreground="White" />
			<TextBox Text="{Binding Location}" />
			<Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
			<TextBlock Text="{Binding Status}" Opacity="0.8" Foreground="White" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
