<UserControl
    x:Class="ChronoWiz.Avalonia.Linux.Views.SaveToIcsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ChronoWiz.Avalonia.Linux.ViewModels"
    x:DataType="vm:SaveToIcsViewModel">
    <ScrollViewer Background="#FF000000">
        <StackPanel
            Margin="20"
            Background="#FF000000"
            Spacing="12">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding GoBackCommand}"
                Content="Back" />
            <Image Source="avares://ChronoWiz.Avalonia.Linux/Assets/IcsFiling/savetoics.png"
				   Height="150" />
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding Title}" />
            <TextBlock Foreground="White" Text="Summary" />
            <TextBox Text="{Binding Summary}" />
            <TextBlock Foreground="White" Text="Description" />
            <TextBox
                MinHeight="80"
                AcceptsReturn="True"
                Text="{Binding Description}" />
            <TextBlock Foreground="White" Text="Location" />
            <TextBox Text="{Binding Location}" />
            <Button
                HorizontalAlignment="Left"
                Command="{Binding SaveCommand}"
                Content="Save" />
            <TextBlock
                Foreground="White"
                Opacity="0.8"
                Text="{Binding Status}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
