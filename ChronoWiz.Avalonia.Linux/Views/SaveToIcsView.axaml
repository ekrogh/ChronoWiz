<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChronoWiz.Avalonia.Linux.ViewModels"
             x:Class="ChronoWiz.Avalonia.Linux.Views.SaveToIcsView"
             x:DataType="vm:SaveToIcsViewModel">
	<ScrollViewer>
		<StackPanel Margin="20" Spacing="12">
			<TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
			<TextBlock Text="Summary" />
			<TextBox Text="{Binding Summary}" />
			<TextBlock Text="Description" />
			<TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="80" />
			<TextBlock Text="Location" />
			<TextBox Text="{Binding Location}" />
			<Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
			<TextBlock Text="{Binding Status}" Opacity="0.8" />
			<TextBlock Text="(Wiring ICS save logic comes next.)" Opacity="0.7" TextWrapping="Wrap" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
