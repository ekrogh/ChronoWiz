<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChronoWiz.Avalonia.Linux.ViewModels"
             x:Class="ChronoWiz.Avalonia.Linux.Views.FileIcsView"
             x:DataType="vm:FileIcsViewModel">
	<ScrollViewer>
		<StackPanel Margin="20" Spacing="12">
			<TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
			<TextBlock Text="{Binding Status}" Opacity="0.8" />
			<TextBlock Text="(Wiring filing workflow comes next.)" Opacity="0.7" TextWrapping="Wrap" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
