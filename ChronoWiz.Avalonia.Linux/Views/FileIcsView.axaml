<UserControl
    x:Class="ChronoWiz.Avalonia.Linux.Views.FileIcsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ChronoWiz.Avalonia.Linux.ViewModels"
    x:DataType="vm:FileIcsViewModel">
    <ScrollViewer Background="#FF000000">
        <StackPanel
            Margin="20"
            Background="#FF000000"
            Spacing="12">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding GoBackCommand}"
                Content="Back" />
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding Title}" />
            <Image
                Source="avares://ChronoWiz/Assets/IcsFiling/fileics.png"
                Height="150"
                HorizontalAlignment="Center"
                Stretch="Uniform" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding GoOpenIcsCommand}" Content="Open .ics" />
                <Button Command="{Binding GoSaveIcsCommand}" Content="Save .ics" />
            </StackPanel>
            <TextBlock
                Foreground="White"
                Opacity="0.8"
                Text="{Binding Status}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
