<UserControl
    x:Class="ChronoWiz.Avalonia.Linux.Views.AboutHelpView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ChronoWiz.Avalonia.Linux.ViewModels"
    x:DataType="vm:AboutHelpViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
            <Button
                HorizontalAlignment="Left"
                Command="{Binding GoBackCommand}"
                Content="Back" />
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="{Binding Title}" />
            <TextBlock
				Text="{Binding AppInfoText}"
				TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Left"
                Command="{Binding OpenUsersGuideCommand}"
                Content="User's Guide" />
            <Separator />
            <TextBlock Text="{Binding Author}" />
            <Button
                HorizontalAlignment="Left"
                Command="{Binding OpenHomePageCommand}"
                Content="{Binding Url}" />
            <Button
                HorizontalAlignment="Left"
                Command="{Binding OpenEmailCommand}"
                Content="{Binding Email}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
