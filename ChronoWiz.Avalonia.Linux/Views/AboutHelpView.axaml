<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChronoWiz.Avalonia.Linux.ViewModels"
             x:Class="ChronoWiz.Avalonia.Linux.Views.AboutHelpView"
             x:DataType="vm:AboutHelpViewModel">
	<ScrollViewer>
		<StackPanel Margin="20" Spacing="12">
			<Button Content="Back" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" />
			<TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
			<TextBlock Text="{Binding AppInfoText}" TextWrapping="Wrap" />
			<Button Content="User's Guide" Command="{Binding OpenUsersGuideCommand}" HorizontalAlignment="Left" />
			<Separator />
			<TextBlock Text="{Binding Author}" />
			<Button Content="{Binding Url}" Command="{Binding OpenHomePageCommand}" HorizontalAlignment="Left" />
			<Button Content="{Binding Email}" Command="{Binding OpenEmailCommand}" HorizontalAlignment="Left" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
